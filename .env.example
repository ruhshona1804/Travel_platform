APP_NAME="Travel Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- MySQL ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travel_platform
DB_USERNAME=travel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Pochta (parolni tiklash va e-pochta tasdiqlash uchun) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Birinchi Super Admin (php artisan db:seed da yaratiladi). Parolni o'zingiz belgilang! ---
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Valyuta kurslari ---
# Hozircha kalitsiz bepul manba (open.er-api.com) ishlatiladi. Provayderni config/travel.php orqali almashtirish mumkin.
EXCHANGE_PROVIDER=open_er_api
EXCHANGE_API_KEY=

# --- AI (ixtiyoriy). Kalit bo'sh bo'lsa, reja qoidalarga asoslangan holda tuziladi ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Google bilan kirish (ixtiyoriy) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Jonli parvoz ma'lumotlari provayderi (hozircha ulanmagan) ---
FLIGHT_PROVIDER=none

VITE_APP_NAME="${APP_NAME}"
